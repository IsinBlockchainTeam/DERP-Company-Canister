{
    "name": "@derp/company-canister",
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "version": "0.0.3",
    "scripts": {
        "test": "jest",
        "start-network": "dfx start --clean",
        "deploy": "set -o allexport; set +o allexport && dfx deploy",
        "build": "npm run generate && mkdir -p dist/src && cp -r ./src/declarations ./dist/src/ && npx tsc -p tsconfig-lib.json",
        "build-types": "npx tsc -p tsconfig-types.json",
        "build-all": "./build-packages.sh",
        "clean": "rm -rf dist && rm -rf src/declarations",
        "prepare-env": "envsubst < canister_ids.json.template > canister_ids.json",
        "generate": "npm run clean && npm run prepare-env && set -o allexport; set +o allexport && dfx build --all && dfx generate && node transform-declarations.js",
        "publish-types": "cd types-dist && npm publish && cd ..",
        "publish-all": "cd types-dist && npm publish && cd .. && npm publish"
    },
    "publishConfig": {
        "registry": "https://gitlab-core.supsi.ch/api/v4/projects/1104/packages/npm/"
    },
    "dependencies": {
        "@derp/company-types": "0.0.4",
        "@dfinity/agent": "^2.2.0",
        "@dfinity/candid": "^2.4.0",
        "@hadronous/pic": "^0.11.0",
        "azle": "^0.24.1",
        "uuidv4": "^6.2.13"
    },
    "devDependencies": {
        "@types/jest": "^29.5.1",
        "@types/text-encoding": "^0.0.40",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.4",
        "tsx": "^4.15.7",
        "typescript": "^5.2.2"
    }
}
